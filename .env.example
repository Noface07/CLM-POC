# Copy to .env and fill in. Neither value is a secret: the consumer key belongs to a
# PKCE public client and is in the page by design; the URL is where the browser is
# sent to sign in. Vite reads this file once, at startup.

# Your org's My Domain. sf org display --target-org clmdemo --verbose prints it.
VITE_SALESFORCE_URL=https://yourorg-dev-ed.develop.my.salesforce.com

# Consumer key of the FM CLM Demo connected app. Retrieve it with
#   sf project retrieve start --metadata ConnectedApp:FM_CLM_Demo --target-org clmdemo
# and read <consumerKey> from the file it writes.
VITE_SF_CLIENT_ID=3MVG9...
